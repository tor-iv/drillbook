# ── Core ──────────────────────────────────────────────────────────────
DB_PATH=./data/drillbook.db
UPLOAD_DIR=./data/photos
APP_URL=http://localhost:3000

# Login PIN (the one thing you type) + cookie signing secret (random 32+ chars)
APP_PIN=1234
AUTH_COOKIE_SECRET=change-me-random-32-bytes-minimum-000000

# Static bearer token for the iOS Shortcut endpoints (/api/status, /api/health-sync)
SHORTCUT_API_TOKEN=change-me-random-token

# Manual trigger secret for /api/cron/* test endpoints
CRON_SECRET=change-me-cron-secret

# ── Scheduled jobs ────────────────────────────────────────────────────
# Off by default in dev so `pnpm dev` doesn't fire emails.
CRON_ENABLED=false
CRON_TIMEZONE=America/New_York

# ── Email (Resend, foefinder.me domain is already verified) ──────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Drillbook <nudge@foefinder.me>
NUDGE_EMAIL_TO=vcox484@gmail.com

# ── AI: coach copy + food calorie estimates (one Anthropic key) ───────
ANTHROPIC_API_KEY=
COACH_MODEL=claude-haiku-4-5
FOOD_MODEL=claude-sonnet-5
# Optional: override the athlete profile fed to the coach prompts
# COACH_PROFILE=

# ── Energy balance (all optional; defaults shown) ─────────────────────
# WEIGHT_GOAL_LB=190
# ATHLETE_HEIGHT_CM=189
# ATHLETE_AGE=25
# ACTIVITY_FACTOR=1.35        # non-exercise multiplier on BMR
# DAILY_DEFICIT_TARGET=400    # ~0.75 lb/week of loss

# ── Google Calendar (see docs/google-setup.md) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMS nudges (Twilio; optional — degrades silently when unset) ──────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NUDGE_SMS_TO=
TWILIO_MESSAGING_SERVICE_SID=
